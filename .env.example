# Supabase (hosted)
SUPABASE_URL=https://your-project.supabase.co
# Prefer new secret key naming; SUPABASE_SERVICE_KEY also supported
SUPABASE_SECRET_KEY=
# Direct Postgres connection (Supabase → Settings → Database → Connection string → URI)
# Used by Docker entrypoint to apply supabase/migrations/*.sql on startup
DATABASE_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres

# Resend webhook signing secrets (one per webhook in Resend dashboard)
RESEND_INBOUND_WEBHOOK_SECRET=
RESEND_EVENTS_WEBHOOK_SECRET=
# Legacy fallback if both endpoints share one secret
RESEND_WEBHOOK_SECRET=

# Encryption key for the Resend API token and other stored secrets.
# Required, at least 32 characters. The server refuses to start in production
# without a real one. Generate with: openssl rand -hex 32
APP_SECRET=

# Node environment (set by deployment platform)
NODE_ENV=development
