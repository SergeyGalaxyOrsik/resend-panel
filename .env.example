# Supabase (hosted)
SUPABASE_URL=https://your-project.supabase.co
# Prefer new secret key naming; SUPABASE_SERVICE_KEY also supported
SUPABASE_SECRET_KEY=

# Resend webhooks (optional but recommended in production)
RESEND_WEBHOOK_SECRET=

# Encryption key for Resend API token and sensitive data
# Generate with: openssl rand -hex 32
APP_SECRET=

# Node environment (set by deployment platform)
NODE_ENV=development
